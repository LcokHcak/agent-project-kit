{
  "description": "会话启动时，如果项目里有 docs/STATUS.md，就把交接单和任务板注入上下文；其他项目里不输出任何内容。",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
